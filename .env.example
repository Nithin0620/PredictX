# ---------------------------------------------------------------------------
# PredictX — root environment template
# Copy to `.env` and fill in values. NEVER commit a real `.env`.
# Per-package templates live at packages/*/.env.example
# ---------------------------------------------------------------------------

# Node environment
NODE_ENV=development

# --- Chain (Base Sepolia) --------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=84532
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Contracts (filled after Phase 4/20 deploy) ----------------------------
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_MARKET_FACTORY_ADDRESS=
NEXT_PUBLIC_ORACLE_RESOLVER_ADDRESS=

# --- Backend ---------------------------------------------------------------
PORT=4000
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Prisma migrations need a direct (non-pooled) Neon connection
DIRECT_URL=postgresql://user:password@host/db?sslmode=require
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
SIWE_DOMAIN=localhost:3000
SIWE_ORIGIN=http://localhost:3000

# --- thirdweb --------------------------------------------------------------
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=

# --- Indexer ---------------------------------------------------------------
INDEXER_START_BLOCK=0
INDEXER_FINALITY_BLOCKS=12
